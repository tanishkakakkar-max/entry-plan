# Copy to .env.local for local dev. On Vercel, set these in Project Settings -> Environment Variables.

# Which AI writes the plans: "groq" (free tier, default) or "anthropic" (Claude, paid, best quality)
LLM_PROVIDER=groq

# Free: get a key at console.groq.com -> API Keys
GROQ_API_KEY=
# Optional: GROQ_MODEL=openai/gpt-oss-120b

# Later, when you switch to Claude: set LLM_PROVIDER=anthropic and add this key (console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: ANTHROPIC_MODEL=claude-sonnet-5-5

# Access codes and credits live in Upstash Redis. Connect it in Vercel: Project -> Storage -> Upstash Redis.
# Vercel adds these for you (either pair works). Locally, without them, the app uses a test code: DEV-TEST.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Password for the private /admin page where you create and top up codes
ADMIN_PASSWORD=

# Live web search (free: 1,000 searches/month at app.tavily.com, no card). Each plan uses 2.
# Leave blank to write plans from the research docs only.
TAVILY_API_KEY=
