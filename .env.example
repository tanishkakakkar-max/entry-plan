# Copy to .env.local for local dev. On Vercel, set these in Project Settings -> Environment Variables.

# Which AI writes the plans: "groq" (free tier, default) or "anthropic" (Claude, paid, best quality)
LLM_PROVIDER=groq

# Free: get a key at console.groq.com -> API Keys
GROQ_API_KEY=
# Optional: GROQ_MODEL=openai/gpt-oss-120b

# Later, when you switch to Claude: set LLM_PROVIDER=anthropic and add this key (console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: require a code to use the tool
ACCESS_CODE=
